# Copy this file to .env on the host running the sidecar and fill in the
# credentials for whichever providers you use. The free models
# (opencode/deepseek-v4-flash-free and friends) need one of these to authenticate.

# Basic auth password the Django app (or any client) uses to talk to the sidecar.
OPENCODE_SERVER_PASSWORD=change-me

# Provider keys (at least one; only set the ones you use).
ZEN_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Port the headless opencode server listens on inside the container.
PORT=4096
